# Environment Variables for wp-mcp-client
# Copy this file to .env and fill in your values

# OpenAI API Configuration
TOKEN_OPENAI_API=your_openai_api_key_here
TOKEN_OPENAI_AUDIO_API=your_openai_audio_api_key_here  # Optional, defaults to TOKEN_OPENAI_API
URL_BASE_OPENAI_API=https://api.openai.com/v1/chat/completions
URL_BASE_OPENAI_AUDIO_API=  # Optional, leave empty for default
MODEL_API_AUDIO_OPENAI=  # Optional, e.g., whisper-1
AUDIO_LANGUAGE=en  # Language for audio transcription (e.g., en, es, pt)
MODEL_API_OPENAI=gpt-4o
MODEL_SUPPORTS_IMAGE=false  # Set to true if using a vision-capable model

# Rate Limiting and Retry Configuration
LIMIT_TOKENS_OPENAI=2000
LIMIT_FETCH=3
LIMIT_TIME=5  # seconds between retries
LIMIT_TOOLS=10  # max tool call iterations
LIMIT_HISTORY=100  # max messages per user in DB
MAX_TOOL_RESULT_LENGTH=8000  # max characters for tool results sent to LLM
SANDBOX_TIMEOUT=30  # seconds for execute_code sandbox timeout
SANDBOX_MEMORY_MB=256  # max memory (MB) for sandbox subprocess
SANDBOX_MAX_TOOL_CALLS=50  # max tool calls per sandbox execution
SANDBOX_MAX_OUTPUT_LENGTH=10000  # max characters for sandbox output
SANDBOX_NETWORK_ACCESS=false  # allow network access in sandbox (false = blocked, true = allowed)
SANDBOX_ALLOWED_TOOLS=  # comma-separated whitelist of tool names allowed in sandbox (empty = all tools allowed)
SANDBOX_STEP_TIMEOUT=30  # timeout in seconds for each step in execute_tool_sequence (default: 30)
MAX_CONTEXT_TOKENS=120000  # max estimated tokens for messages array (truncates oldest messages when exceeded)
SQLITE_DATABASE=db.sqlite  # Path to SQLite database file (default: db.sqlite)

# Admin Configuration
ADMIN_USERS=  # Comma-separated list of phone numbers (with country code, no + or spaces)
# Example: ADMIN_USERS=15551234567,15559876543

# Browser Configuration (for Puppeteer)
BROWSER=  # Optional path to browser executable

# Miscellaneous
TEST_MODE=false  # Set to true to reduce logging during development
INSTRUCTIONS=instructions.txt  # Path to custom instructions file

# MCP Configuration
MCP_TOOL_THRESHOLD=15  # Max tools before switching to progressive discovery (search meta-tools)
MCP_STABLE_TOOLS=true  # When true, always use call_tool wrapper (keeps tools array stable for prompt caching). Default: true
CACHE_TTL=300  # Cache TTL in seconds for tool definitions (default: 300 = 5 minutes)
TOOL_TIMEOUT=60  # Timeout in seconds for a single MCP tool call (default: 60)
IDLE_TIMEOUT=1800  # Idle timeout in seconds before disconnecting a server (default: 1800 = 30 minutes). Servers with tools in active LLM context are pinned and won't be disconnected.

# Tool confirmation (human in the loop)
# The host asks the user to approve a tool call before executing it.
# CONFIRM_TOOLS accepts comma separated glob patterns (* and ? wildcards) matched against
# "server__tool" and against the bare tool name. The read-only discovery helpers
# (search_tools, get_tool_details, search_available_servers, list_resources,
# read_resource, list_prompts, get_prompt) are never confirmed.
# Empty  -> every MCP tool call requires confirmation (default)
# none   -> no tool requires confirmation
# Example: CONFIRM_TOOLS=delete*,*__write_*
CONFIRM_TOOLS=
CONFIRM_TIMEOUT=120  # Seconds to wait for the answer of the user (default: 120)

# Observability
LOG_LEVEL=info  # debug | info | warn | error
LOG_FORMAT=text  # text | json (one JSON object per line)

# SEP-2243 (x-mcp-header) parameter mirroring for Streamable HTTP servers
# auto   -> mirror the annotated parameters into Mcp-Param-* headers (default)
# always -> also send the standard Mcp-Method and Mcp-Name headers
# never  -> do not mirror any parameter
MCP_HEADER_MODE=auto
# Environment Variables for wp-mcp-client
# Copy this file to .env and fill in your values

# OpenAI API Configuration
TOKEN_OPENAI_API=your_openai_api_key_here
TOKEN_OPENAI_AUDIO_API=your_openai_audio_api_key_here  # Optional, defaults to TOKEN_OPENAI_API
URL_BASE_OPENAI_API=https://api.openai.com/v1/chat/completions
URL_BASE_OPENAI_AUDIO_API=  # Optional, leave empty for default
MODEL_API_AUDIO_OPENAI=  # Optional, e.g., whisper-1
MODEL_API_OPENAI=gpt-4o
MODEL_SUPPORTS_IMAGE=false  # Set to true if using a vision-capable model

# Rate Limiting and Retry Configuration
LIMIT_TOKENS_OPENAI=2000
LIMIT_FETCH=3
LIMIT_TIME=5  # seconds between retries
LIMIT_TOOLS=10  # max tool call iterations

# Admin Configuration
ADMIN_USERS=  # Comma-separated list of phone numbers (with country code, no + or spaces)
# Example: ADMIN_USERS=15551234567,15559876543

# Browser Configuration (for Puppeteer)
BROWSER=  # Optional path to browser executable

# Miscellaneous
TEST_MODE=false  # Set to true to reduce logging during development
INSTRUCTIONS=instructions.txt  # Path to custom instructions file